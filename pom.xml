<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>fr.feneck91</groupId>
    <artifactId>WorldGuardInteractExt</artifactId>
    <version>4.1</version>
    <packaging>jar</packaging>
    <name>WorldGuardInteractExt</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
    </properties>

    <repositories>
        <repository>
            <id>spigot-repo</id>
            <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
        </repository>
        <repository>
            <id>sk89q-repo</id>
            <url>https://maven.enginehub.org/repo/</url>
        </repository>
    </repositories>

    <dependencies>
        <!--Spigot API-->
        <dependency>
            <groupId>org.spigotmc</groupId>
            <artifactId>spigot-api</artifactId>
            <version>1.20.1-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>
        <!-- WorldEdit -->
        <dependency>
            <groupId>com.sk89q.worldguard</groupId>
            <artifactId>worldguard-bukkit</artifactId>
            <version>7.0.9</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <!-- Plugin compilation -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>21</source>
                    <target>21</target>
                </configuration>
            </plugin>
            <!-- Plugin to copy .jar after the build -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <!-- Compute source file checksums -->
                                <checksum file="${project.build.directory}/${project.build.finalName}.jar"
                                          property="src.md5"
                                          algorithm="MD5"/>
                                <echo level="info"
                                      message="Jar file = ${project.build.directory}/${project.build.finalName}.jar / MD5 = ${src.md5}"/>

                                <!--================-->
                                <!-- Copy to server -->
                                <!--================-->
                                <copy file="${project.build.directory}/${project.build.finalName}.jar"
                                      todir="server/plugins/"
                                      overwrite="true"
                                      failonerror="true"/>
                                <!-- Compute checksums -->
                                <checksum file="server/plugins/${project.build.finalName}.jar"
                                          property="dst1.md5"
                                          algorithm="MD5"/>
                                <echo level="info"
                                      message="Jar file = server/plugins/${project.build.finalName}.jar / MD5 = ${dst1.md5}"/>
                                <!-- Compare checksum -->
                                <condition property="copy.success">
                                    <equals arg1="${src.md5}" arg2="${dst1.md5}"/>
                                </condition>
                                <fail unless="copy.success"
                                      message="[ERROR] Copy to server error: destination file is not updated!"/>
                                <echo level="info"
                                      message="[OK] Copy to Server"/>

                                <!--=============-->
                                <!-- Copy to jar -->
                                <!--=============-->
                                <copy file="${project.build.directory}/${project.build.finalName}.jar"
                                      todir="jar/"
                                      overwrite="true"
                                      failonerror="true"/>
                                <!-- Compute checksums -->
                                <checksum file="jar/${project.build.finalName}.jar"
                                          property="dst2.md5"
                                          algorithm="MD5"/>
                                <echo level="info"
                                      message="Jar file = jar/${project.build.finalName}.jar / MD5 = ${dst2.md5}"/>
                                <!-- Compare checksum -->
                                <condition property="copy2.success">
                                    <equals arg1="${src.md5}" arg2="${dst2.md5}"/>
                                </condition>

                                <fail unless="copy2.success"
                                      message="[ERROR] Copy to jar folder error: internal plugin jar folder is not updated!"/>
                                <echo level="info"
                                      message="[OK] Copy to internal plugin jar folder"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Plugin javadoc  -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>generate-javadocs</id>
                        <phase>package</phase>
                        <goals>
                            <goal>javadoc</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <destDir>../../../javadocs</destDir>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>